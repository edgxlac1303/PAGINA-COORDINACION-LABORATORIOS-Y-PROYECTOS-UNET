---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { 
    title = "Coordinación de Laboratorios y Proyectos UNET",
    mostrarTituloHeader = false,
    mostrarBuscadorHeader = false,
    mostrarNavegacion = true
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
</head>
<body>

<Header 
        mostrarTituloHeader={mostrarTituloHeader}
        mostrarBuscadorHeader={mostrarBuscadorHeader}
        mostrarNavegacion={mostrarNavegacion}
    />

<main>
    <slot />
</main>

<Footer />

</body>
</html>
