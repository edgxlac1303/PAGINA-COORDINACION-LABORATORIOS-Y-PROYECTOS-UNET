---
import Layout from '../layouts/Layout.astro';
import TarjetaLaboratorio from '../components/TarjetaLaboratorio.astro';
import { laboratorios } from '../data/laboratorios.js';

const laboratoriosPagina2 = laboratorios.slice(32, 64);
---

<Layout title="Laboratorios | Página 2 | Coordinación de Laboratorios y Proyectos UNET">

    <div class="contenedor">

        <section class="pagina-laboratorios">

            <div class="encabezado-pagina">
                <h2>Laboratorios</h2>
                <p>
                    En esta sección se presenta la segunda parte del listado de laboratorios registrados,
                    indicando su ubicación, aula asignada y departamento correspondiente.
                </p>
            </div>

            <div class="buscador-laboratorios">
                <input type="text" placeholder="Buscar laboratorio, aula o departamento">
            </div>

            <div class="filtros-laboratorios">
                <button>Todos</button>
                <button>Informática</button>
                <button>Electrónica</button>
                <button>Mecánica</button>
                <button>Industrial</button>
                <button>Ciencias Básicas</button>
            </div>

            <div class="contador-laboratorios">
                <p>Mostrando laboratorios 33 al 64 de {laboratorios.length}</p>
            </div>

            <div class="grid-laboratorios">
                {
                    laboratoriosPagina2.map((laboratorio) => (
                        <TarjetaLaboratorio
                            nombre={laboratorio.nombre}
                            departamento={laboratorio.departamento}
                            ubicacion={laboratorio.ubicacion}
                            aula={laboratorio.aula}
                        />
                    ))
                }
            </div>

            <div class="paginacion-laboratorios">
                <a href="/laboratorios">Página anterior</a>
                <a href="/laboratorios">1</a>
                <span class="pagina-activa">2</span>
            </div>

        </section>

    </div>

</Layout>