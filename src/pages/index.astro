---
import Layout from '../layouts/Layout.astro';
import HeroInicio from '../components/HeroInicio.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import CarruselNovedades from '../components/CarruselNovedades.astro';
---

<Layout title="Coordinación de Laboratorios y Proyectos UNET">
    <div class="contenedor"> <!-- contenedor general de contenido del main -->

        <HeroInicio />

        <section class="servicios_portal">
            <h2>Servicios principales del portal</h2>

            <div class="contenedor-tarjetas">
                <TarjetaServicio
                    titulo="Laboratorios"
                    descripcion="Consulta información sobre los laboratorios disponibles, responsables y servicios principales."
                    enlace="/laboratorios"
                    textoEnlace="Ver laboratorios"
                />

                <TarjetaServicio
                    titulo="Proyectos"
                    descripcion="Revisa proyectos académicos y tecnológicos vinculados a los espacios de laboratorio."
                    enlace="/proyectos"
                    textoEnlace="Ver proyectos"
                />

                <TarjetaServicio
                    titulo="Mantenimiento"
                    descripcion="Registra solicitudes de revisión, reparación o mantenimiento de los laboratorios."
                    enlace="/mantenimiento"
                    textoEnlace="Solicitar mantenimiento"
                />

                <TarjetaServicio
                    titulo="Reseña histórica"
                    descripcion="Accede a la memoria histórica de la Coordinación de Laboratorios y Proyectos de la UNET."
                    enlace="/historia"
                    textoEnlace="Ver reseña histórica"
                />

                <TarjetaServicio
                    titulo="Ubicación 360°"
                    descripcion="Consulta la ubicación de laboratorios y accede al recorrido virtual."
                    enlace="/ubicacion"
                    textoEnlace="Ver ubicación"
                />
            </div>
        </section>

        <CarruselNovedades />

    </div>
</Layout>
