---
import Layout from '../layouts/Layout.astro';
import TarjetaLaboratorio from '../components/TarjetaLaboratorio.astro';
import { laboratorios } from '../data/laboratorios.js';

const laboratoriosPagina1 = laboratorios.slice(0, 32);
---

<Layout title="Laboratorios | Coordinación de Laboratorios y Proyectos UNET">

    <div class="contenedor">

        <section class="pagina-laboratorios">

            <div class="encabezado-pagina">
                <h2>Laboratorios</h2>
                <p>
                    En esta sección se presenta el listado de laboratorios registrados,
                    indicando su ubicación, aula asignada y departamento correspondiente.
                </p>
            </div>

            <div class="buscador-laboratorios">
                <input type="text" placeholder="Buscar laboratorio, aula o departamento">
            </div>

            <div class="filtros-laboratorios">
                <button>Todos</button>
                <button>Informática</button>
                <button>Electrónica</button>
                <button>Mecánica</button>
                <button>Arquitectura</button>
                <button> Química</button>
                <button> Matemática y Física</button>
                <button> Civil</button>
                <button> Producción Animal</button>
                <button> Agronómica</button>
            </div>

            <div class="contador-laboratorios">
                <p>Mostrando laboratorios 1 al 32 de {laboratorios.length}</p>
            </div>

            <div class="grid-laboratorios">
                {
                    laboratoriosPagina1.map((laboratorio) => (
                        <TarjetaLaboratorio
                            nombre={laboratorio.nombre}
                            departamento={laboratorio.departamento}
                            ubicacion={laboratorio.ubicacion}
                            aula={laboratorio.aula}
                        />
                    ))
                }
            </div>

            <div class="paginacion-laboratorios">
                <span class="pagina-activa">1</span>
                <a href="/laboratorios-2">2</a>
                <a href="/laboratorios-2" class="boton-paginacion">Página siguiente</a>
            </div>

        </section>

    </div>

</Layout>