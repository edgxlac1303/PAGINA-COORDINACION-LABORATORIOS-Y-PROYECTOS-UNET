---
import Layout from '../layouts/Layout.astro';
import TarjetaLaboratorio from '../components/TarjetaLaboratorio.astro';
import { laboratorios } from '../data/laboratorios.js';

/* NORMALIZA TEXTO PARA COMPARAR NOMBRES SIN PROBLEMAS DE MAYUSCULAS O ACENTOS */
function normalizarTextoServidor(texto: string): string {
    return texto
        .trim()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/\s+/g, ' ')
        .toLowerCase();
}

/* IDS INTERNOS DE LOS LABORATORIOS QUE YA EXISTEN EN EL RECORRIDO 360 */
const idsUbicacionPorNombre: Record<string, string> = {
    [normalizarTextoServidor('Entrada principal del Edificio 11')]: 'entrada-edificio-a',
    [normalizarTextoServidor('Laboratorio de Química 071')]: 'quimica-071',
    [normalizarTextoServidor('Laboratorio de Química Orgánica')]: 'quimica-organica-1',
    [normalizarTextoServidor('Laboratorio de Química 072')]: 'quimica-072',
    [normalizarTextoServidor('Laboratorio de Química 2')]: 'quimica-2',
    [normalizarTextoServidor('Laboratorio de Física II')]: 'fisica-ii-1',
    [normalizarTextoServidor('Laboratorio de Física I')]: 'fisica-i-1',
    [normalizarTextoServidor('Laboratorio de Máquinas y Herramientas')]: 'maquinas-herramientas',
    [normalizarTextoServidor('Laboratorio de Conformados')]: 'conformados',
    [normalizarTextoServidor('Laboratorio de TurboMáquinas y Planta de Potencia')]: 'turbomaquinas-planta-potencia',
    [normalizarTextoServidor('Laboratorio de TurboMáquinas y Planta de Poténncia')]: 'turbomaquinas-planta-potencia',
    [normalizarTextoServidor('Laboratorio de Pavimentos')]: 'pavimentos',
    [normalizarTextoServidor('Laboratorio de TermoFluídos y Planta de Poténcia')]: 'termofluidos-planta-potencia',
    [normalizarTextoServidor('Laboratorio de Fisiología y Sanidad Animal')]: 'fisiologia-sanidad-animal',
    [normalizarTextoServidor('Laboratorio de Anatomía')]: 'anatomia',
    [normalizarTextoServidor('Laboratorio de Suelos')]: 'suelos',
    [normalizarTextoServidor('Laboratorio de Ingeniería Ambiental')]: 'ingenieria-ambiental-1',
    [normalizarTextoServidor('Laboratorio de Componentes Constructivos')]: 'componentes-constructivos',

    [normalizarTextoServidor('Laboratorios Valerio Wong')]: 'valerio-wong',
    [normalizarTextoServidor('Laboratorios Valerio Wong Piso 2')]: 'valerio-wong-piso-2',
    [normalizarTextoServidor('Laboratorio de Agroindustrial')]: 'agroindustrial',
    [normalizarTextoServidor('Laboratorio de Industrias de la Leche')]: 'industrias-leche',
    [normalizarTextoServidor('Laboratorio Entomología')]: 'entomologia',
    [normalizarTextoServidor('Laboratorio de Nutricion Animal')]: 'nutricion-animal',
    [normalizarTextoServidor('Laboratorio de Genética')]: 'genetica',
    [normalizarTextoServidor('Laboratorio de Bioquímica 083')]: 'bioquimica-083',
    [normalizarTextoServidor('Laboratorio de Ingeniería de Métodos')]: 'ingenieria-metodos',
    [normalizarTextoServidor('Laboratorio de Biología')]: 'biologia',
    [normalizarTextoServidor('Laboratorio de Botánica Agrícola')]: 'botanica-agricola',
    [normalizarTextoServidor('Laboratorio de Forrajicultura')]: 'forrajicultura',
    [normalizarTextoServidor('Laboratorio de Autoclave')]: 'autoclave',
    [normalizarTextoServidor('Laboratorio de Fisiología Vegetal')]: 'fisiologia-vegetal',
    [normalizarTextoServidor('Laboratorio de Fitopatología')]: 'fitopatologia',
    [normalizarTextoServidor('Laboratorio de Cultivo de Tejidos')]: 'cultivo-tejidos',
    [normalizarTextoServidor('Laboratorio de Microbiología')]: 'microbiologia',
    [normalizarTextoServidor('Laboratorio de Sistemas de Comunicaciones e Ingeniería de redes')]: 'sistemas-comunicaciones-redes',
    [normalizarTextoServidor('Laboratorio de Electrónica Analógica')]: 'electronica-analogica',
    [normalizarTextoServidor('Laboratorio de Sistemas Digitales y Microprocesadores')]: 'sistemas-digitales-microprocesadores',
    [normalizarTextoServidor('Laboratorio de LRF y Microondas')]: 'lrf-microondas',
    [normalizarTextoServidor('Laboratorio de Circuítos y Mediciones')]: 'circuitos-mediciones',
    [normalizarTextoServidor('Laboratorio de Sistemas Digitales II')]: 'sistemas-digitales-ii',
    [normalizarTextoServidor('Coordinación de Laboratorio y Proyectos')]: 'coordinacion-laboratorio-proyectos',
    [normalizarTextoServidor('Laboratorio de Electrica y Electrotécnia')]: 'electrica-electrotecnia',
    [normalizarTextoServidor('Laboratorio de Electrónica Industrial (Profei)')]: 'electronica-industrial-profei',
    [normalizarTextoServidor('Laboratorio de Tecnología Eléctrica')]: 'tecnologia-electrica',
    [normalizarTextoServidor('Laboratorio de Proyecto de Instrumentación Electrónica y Control')]: 'proyecto-instrumentacion-electronica-control',
    [normalizarTextoServidor('Laboratorio de Tecnología Electrónica')]: 'tecnologia-electronica',
    [normalizarTextoServidor('Laboratorio de Sistema de Control e Instrumentación Industrial')]: 'sistema-control-instrumentacion-industrial',
    [normalizarTextoServidor('Laboratorio de Ingeniería Eléctrica y Electrotécnia')]: 'ingenieria-electrica-electrotecnia',
    [normalizarTextoServidor('Laboratorio de Investigación y Desarrollo en Informática')]: 'investigacion-desarrollo-informatica',
    [normalizarTextoServidor('Laboratorio de Materiales')]: 'materiales',
    [normalizarTextoServidor('Laboratorio de Transferencia de Calor')]: 'transferencia-calor',
    [normalizarTextoServidor('Laboratorio de Mecánica de Fluidos')]: 'mecanica-fluidos'
};

type Laboratorio = {
    nombre: string;
    departamento?: string;
    ubicacion?: string;
    aula?: string;
    idUbicacion?: string;
};

/* OBTIENE EL ENLACE DE UBICACION DE CADA TARJETA */
function obtenerEnlaceUbicacion(laboratorio: Laboratorio): string {
    const idUbicacion = laboratorio.idUbicacion || idsUbicacionPorNombre[normalizarTextoServidor(laboratorio.nombre)];

    if (!idUbicacion) {
        return '/ubicacion';
    }

    return `/ubicacion?lab=${idUbicacion}`;
}
---

<Layout title="Laboratorios | Coordinación de Laboratorios y Proyectos UNET">

    <div class="contenedor">

        <section class="pagina-laboratorios"> <!-- PAGINA DE LABORATORIOS -->

            <div class="encabezado-pagina"> <!-- ENCABEZADO DE LA PAGINA -->
                <h2>Laboratorios</h2>

                <p>
                    En esta sección se presenta el listado de laboratorios registrados,
                    indicando su ubicación, aula asignada y departamento correspondiente.
                </p>
            </div>

            <div class="buscador-laboratorios"> <!-- BUSCADOR DE LABORATORIOS -->
                <input 
                    type="text" 
                    id="buscadorLaboratorios"
                    placeholder="Buscar laboratorio, aula o departamento"
                >
            </div>

            <div class="filtros-laboratorios"> <!-- FILTROS DE DEPARTAMENTOS -->
                <button type="button" class="btn-filtro-laboratorio activo" data-filtro="todos">Todos</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="informatica">Informática</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="electronica">Electrónica</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="mecanica">Mecánica</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="arquitectura">Arquitectura</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="quimica">Química</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="matematica y fisica">Matemática y Física</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="civil">Civil</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="produccion animal">Producción Animal</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="agronomica">Agronómica</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="industrial">Industrial</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="agroindustrial">Agroindustrial</button>
                <button type="button" class="btn-filtro-laboratorio" data-filtro="ambiental">Ambiental</button>
            </div>

            <div class="contador-laboratorios">
                <p id="contadorLaboratorios">
                    Mostrando laboratorios 1 al 32 de {laboratorios.length}
                </p>
            </div>

            <p id="mensajeSinResultados" class="mensaje-sin-resultados oculto">
                No se encontraron laboratorios con ese criterio de búsqueda.
            </p>

            <div class="grid-laboratorios"> <!-- CONTENEDOR DE TARJETAS -->
                {
                    laboratorios.map((laboratorio) => (
                        <div 
                            class="item-laboratorio"
                            data-departamento={laboratorio.departamento}
                            data-busqueda={`${laboratorio.nombre} ${laboratorio.departamento} ${laboratorio.ubicacion} ${laboratorio.aula}`}
                        >
                            <TarjetaLaboratorio
                                nombre={laboratorio.nombre}
                                departamento={laboratorio.departamento}
                                ubicacion={laboratorio.ubicacion}
                                aula={laboratorio.aula}
                                enlaceUbicacion={obtenerEnlaceUbicacion(laboratorio)}
                            />
                        </div>
                    ))
                }
            </div>

            <div class="paginacion-laboratorios"> <!-- PAGINACION -->
                <button type="button" id="btnPaginaAnterior" class="boton-paginacion">
                    Página anterior
                </button>

                <div id="numerosPaginacion" class="numeros-paginacion"></div>

                <button type="button" id="btnPaginaSiguiente" class="boton-paginacion">
                    Página siguiente
                </button>
            </div>

        </section>

    </div>

    <script is:inline>
        // BUSCADOR, FILTROS Y PAGINACION DE LABORATORIOS

        const buscadorLaboratorios = document.getElementById("buscadorLaboratorios");
        const botonesFiltro = document.querySelectorAll(".btn-filtro-laboratorio");
        const itemsLaboratorios = Array.from(document.querySelectorAll(".item-laboratorio"));
        const mensajeSinResultados = document.getElementById("mensajeSinResultados");
        const contadorLaboratorios = document.getElementById("contadorLaboratorios");
        const btnPaginaAnterior = document.getElementById("btnPaginaAnterior");
        const btnPaginaSiguiente = document.getElementById("btnPaginaSiguiente");
        const numerosPaginacion = document.getElementById("numerosPaginacion");

        const laboratoriosPorPagina = 32;

        let paginaActual = 1;
        let filtroActual = "todos";

        function normalizarTexto(texto) {
            return texto
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");
        }

        function obtenerLaboratoriosFiltrados() {
            const textoBuscado = normalizarTexto(buscadorLaboratorios.value);

            return itemsLaboratorios.filter(function (item) {
                const contenido = normalizarTexto(item.dataset.busqueda);
                const departamento = normalizarTexto(item.dataset.departamento);

                const coincideBusqueda = contenido.includes(textoBuscado);

                const coincideFiltro = 
                    filtroActual === "todos" || departamento.includes(filtroActual);

                return coincideBusqueda && coincideFiltro;
            });
        }

        function crearBotonesPaginacion(totalPaginas) {
            numerosPaginacion.innerHTML = "";

            for (let i = 1; i <= totalPaginas; i++) {
                const botonPagina = document.createElement("button");

                botonPagina.type = "button";
                botonPagina.textContent = i;
                botonPagina.classList.add("btn-numero-pagina");

                if (i === paginaActual) {
                    botonPagina.classList.add("pagina-activa");
                }

                botonPagina.addEventListener("click", function () {
                    paginaActual = i;
                    actualizarVistaLaboratorios();
                });

                numerosPaginacion.appendChild(botonPagina);
            }
        }

        function actualizarVistaLaboratorios() {
            const laboratoriosFiltrados = obtenerLaboratoriosFiltrados();
            const totalResultados = laboratoriosFiltrados.length;
            const totalPaginas = Math.ceil(totalResultados / laboratoriosPorPagina);

            itemsLaboratorios.forEach(function (item) {
                item.classList.add("oculto");
            });

            if (totalResultados === 0) {
                mensajeSinResultados.classList.remove("oculto");
                contadorLaboratorios.textContent = "No hay laboratorios para mostrar.";
                btnPaginaAnterior.disabled = true;
                btnPaginaSiguiente.disabled = true;
                numerosPaginacion.innerHTML = "";
                return;
            }

            mensajeSinResultados.classList.add("oculto");

            if (paginaActual > totalPaginas) {
                paginaActual = 1;
            }

            const inicio = (paginaActual - 1) * laboratoriosPorPagina;
            const fin = inicio + laboratoriosPorPagina;

            const laboratoriosPaginaActual = laboratoriosFiltrados.slice(inicio, fin);

            laboratoriosPaginaActual.forEach(function (item) {
                item.classList.remove("oculto");
            });

            const primerResultado = inicio + 1;
            const ultimoResultado = Math.min(fin, totalResultados);

            contadorLaboratorios.textContent = 
                "Mostrando laboratorios " + primerResultado + 
                " al " + ultimoResultado + 
                " de " + totalResultados + " resultado(s).";

            btnPaginaAnterior.disabled = paginaActual === 1;
            btnPaginaSiguiente.disabled = paginaActual === totalPaginas;

            crearBotonesPaginacion(totalPaginas);
        }

        buscadorLaboratorios.addEventListener("input", function () {
            paginaActual = 1;
            actualizarVistaLaboratorios();
        });

        botonesFiltro.forEach(function (boton) {
            boton.addEventListener("click", function () {
                botonesFiltro.forEach(function (botonFiltro) {
                    botonFiltro.classList.remove("activo");
                });

                boton.classList.add("activo");

                filtroActual = normalizarTexto(boton.dataset.filtro);
                paginaActual = 1;

                actualizarVistaLaboratorios();
            });
        });

        btnPaginaAnterior.addEventListener("click", function () {
            if (paginaActual > 1) {
                paginaActual--;
                actualizarVistaLaboratorios();
            }
        });

        btnPaginaSiguiente.addEventListener("click", function () {
            const totalPaginas = Math.ceil(obtenerLaboratoriosFiltrados().length / laboratoriosPorPagina);

            if (paginaActual < totalPaginas) {
                paginaActual++;
                actualizarVistaLaboratorios();
            }
        });

        actualizarVistaLaboratorios();
    </script>

</Layout>