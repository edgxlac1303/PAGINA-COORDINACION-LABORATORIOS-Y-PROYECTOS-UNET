---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Recorrido 360 | Coordinación de Laboratorios y Proyectos UNET">

    <div class="contenedor">

        <section class="pagina-contenido">

            <h2>Recorrido virtual 360°</h2>

            <p>
                En esta sección se muestra una prueba del recorrido virtual de los espacios
                de laboratorios utilizando una imagen panorámica 360°.
            </p>

            <div id="visor360"></div>

        </section>

    </div>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.7/build/pannellum.css">

    <script is:inline src="https://cdn.jsdelivr.net/npm/pannellum@2.5.7/build/pannellum.js"></script>

    <script is:inline>
        pannellum.viewer('visor360', {
            type: 'equirectangular',
            panorama: '/assets/recorridos360/prueba1.jpeg',
            autoLoad: true,
            title: 'Prueba de recorrido 360°',
            author: 'Coordinación de Laboratorios y Proyectos UNET',
            pitch: 0,
            yaw: 0,
            hfov: 100,
            hotSpotDebug: true,

            hotSpots: [
                {
                    pitch: 0,
                    yaw: 20,
                    type: 'info',
                    text: 'Aula 12C13 - Laboratorio de Bioquímica'
                },
                {
                    pitch: 12.91,
                    yaw: 120,
                    type: 'info',
                    text: 'Entrada al laboratorio'
                }
            ]
        });
    </script>

</Layout>