/*ELEMENTOS DEL BUSCADOR DEL RECORRIDO 360*/
const inputBuscarBloque1 = document.getElementById('buscarLaboratorioBloque1');
const botonBuscarBloque1 = document.getElementById('botonBuscarLaboratorioBloque1');

/*FUNCION PARA BUSCAR UN LABORATORIO EN EL RECORRIDO*/
function buscarLaboratorioBloque1() {
    const textoBuscado = inputBuscarBloque1.value.trim().toLowerCase();

    const laboratorioEncontrado = laboratoriosBloque1.find((laboratorio) => {
        return laboratorio.nombre.toLowerCase() === textoBuscado;
    });

    if (!laboratorioEncontrado) {
        alert('Laboratorio no encontrado en el recorrido.');
        return;
    }

    recorridoBloque1.loadScene(
        laboratorioEncontrado.escena,
        laboratorioEncontrado.pitch,
        laboratorioEncontrado.yaw,
        laboratorioEncontrado.hfov
    );
}

/*BUSCAR AL HACER CLIC EN EL BOTON*/
botonBuscarBloque1.addEventListener('click', buscarLaboratorioBloque1);

/*BUSCAR AL PRESIONAR ENTER*/
inputBuscarBloque1.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
        buscarLaboratorioBloque1();
    }
});























