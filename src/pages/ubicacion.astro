---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ubicación 360 | Coordinación de Laboratorios y Proyectos UNET">

    <div class="contenedor">

        <section class="pagina-contenido">

            <h2>Recorrido virtual 360° - Edificio A</h2>

            <p>
                En esta sección se muestra el recorrido virtual 360 correspondiente al Edificio A,
                permitiendo visualizar los laboratorios de la universidad.
            </p>

            <div class="buscador-recorrido"> <!-- BUSCADOR DEL RECORRIDO 360 -->

                <input 
                    type="text" 
                    id="buscarLaboratorioBloque1" 
                    placeholder="Busca tu Laboratorio"
                    list="listaLaboratoriosBloque1"
                >

                <datalist id="listaLaboratoriosBloque1">
                    <option value="Entrada principal del Edificio 11"></option>
                    <option value="Laboratorio de Química 071"></option>
                    <option value="Laboratorio de Química Orgánica"></option>
                    <option value="Laboratorio de Química 072"></option>
                    <option value="Laboratorio de Química 2"></option>
                    <option value="Laboratorio de Química Orgánica"></option>
                    <option value="Laboratorio de Física II"></option>
                    <option value="Laboratorio de Física I"></option>
                    <option value="Laboratorio de Física II"></option>
                    <option value="Laboratorio de Física I"></option>
                    <option value="Laboratorio de Máquinas y Herramientas"></option>
                    <option value="Laboratorio de Conformados"></option>
                    <option value="Laboratorio de TurboMáquinas y Planta de Poténncia"></option>
                    <option value="Laboratorio de Pavimentos"></option>
                    <option value="Laboratorio de TermoFluídos y Planta de Poténcia"></option>
                    <option value="Laboratorio de Fisiología y Sanidad Animal"></option>
                    <option value="Laboratorio de Anatomía"></option>
                    <option value="Laboratorio de Suelos"></option>
                    <option value="Laboratorio de Ingeniería Ambiental"></option>
                    <option value="Laboratorio de Componentes Constructivos "></option>
                    <option value="Laboratorio de Ingeniería Ambiental"></option>
                </datalist>

                <button id="botonBuscarLaboratorioBloque1">
                    Buscar
                </button>

            </div>

            <div id="visorEdificio11"></div>

        </section>

    </div>

    <div class="contenedor">

        <section class="pagina-contenido">

            <h2>Recorrido virtual 360° - Edificio C</h2>

            <p>
                En esta sección se muestra el recorrido virtual 360 correspondiente al Edificio C,
                permitiendo visualizar los laboratorios de la universidad.
            </p>
            <div class="buscador-recorrido"> <!-- BUSCADOR DEL RECORRIDO 360 DEL BLOQUE 2 -->

                <input 
