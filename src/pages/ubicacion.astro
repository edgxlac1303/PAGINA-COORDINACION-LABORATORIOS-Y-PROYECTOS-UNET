/*ELEMENTOS DEL BUSCADOR DEL RECORRIDO 360 DEL BLOQUE 2*/
const inputBuscarBloque2 = document.getElementById('buscarLaboratorioBloque2');
const botonBuscarBloque2 = document.getElementById('botonBuscarLaboratorioBloque2');

/*FUNCION PARA BUSCAR UN LABORATORIO EN EL RECORRIDO DEL BLOQUE 2*/
function buscarLaboratorioBloque2() {
    const textoBuscado = inputBuscarBloque2.value.trim().toLowerCase();

    const laboratorioEncontrado = laboratoriosBloque2.find((laboratorio) => {
        return laboratorio.nombre.toLowerCase() === textoBuscado;
    });

    if (!laboratorioEncontrado) {
        alert('Laboratorio no encontrado en el recorrido del Edificio 12.');
        return;
    }

    recorridoBloque2.loadScene(
        laboratorioEncontrado.escena,
        laboratorioEncontrado.pitch,
        laboratorioEncontrado.yaw,
        laboratorioEncontrado.hfov
    );
}

/*BUSCAR AL HACER CLIC EN EL BOTON*/
botonBuscarBloque2.addEventListener('click', buscarLaboratorioBloque2);

/*BUSCAR AL PRESIONAR ENTER*/
inputBuscarBloque2.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
        buscarLaboratorioBloque2();
    }
});