---
const { 
    mostrarTituloHeader = false,
    mostrarBuscadorHeader = false,
    mostrarNavegacion = true
} = Astro.props;
---

<header>

    <div class="barra-superior">
        <a href="https://www.unet.edu.ve/" target="_blank" rel="noopener noreferrer">
            <img src="/assets/img/logo-unet-blanco.png" alt="Imagotipo UNET" class="logo-unet">
        </a>

        <p>Universidad Nacional Experimental del Táchira</p>

        <img 
    src="/assets/img/logo_decanato_blanco.png" 
    alt="Imagotipo DECANATO" 
    class="logo-decanato-header"
    style="width: 80px; max-width: 80px; height: auto; max-height: 75px; object-fit: contain;"
>
    </div>

    <nav class={mostrarNavegacion ? "" : "oculto"}>
        <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/laboratorios">Laboratorios</a></li>
            <li><a href="/proyectos">Proyectos</a></li>
            <li><a href="/ubicacion">Ubicación</a></li>
            <li><a href="/mantenimiento">Mantenimiento</a></li>
        </ul>
    </nav>

    <div class={mostrarTituloHeader ? "titulo-header" : "titulo-header oculto"}>

        <div class="titulo-con-logo">

            <div class="titulo-texto">
                <h1>Coordinación de Laboratorios y Proyectos</h1>
                <p>Portal Informativo Institucional</p>
            </div>

        </div>

        <div class={mostrarBuscadorHeader ? "buscador-header" : "buscador-header oculto"}>

            <input 
                type="text" 
                id="buscadorPortal" 
                placeholder="Buscar laboratorio o proyecto"
            >

            <button type="button" id="botonBuscarPortal">Buscar</button>

        </div>

    </div>

</header>

<script is:inline>
    // BUSCADOR GENERAL DEL PORTAL

    document.addEventListener("DOMContentLoaded", function () {
        const buscadorPortal = document.getElementById("buscadorPortal");
        const botonBuscarPortal = document.getElementById("botonBuscarPortal");

        if (!buscadorPortal || !botonBuscarPortal) {
            return;
        }

        function buscarEnPortal() {
            const textoBusqueda = buscadorPortal.value.trim();

            if (textoBusqueda === "") {
                return;
            }

            window.location.href = "/busqueda?consulta=" + encodeURIComponent(textoBusqueda);
        }

        botonBuscarPortal.addEventListener("click", function () {
            buscarEnPortal();
        });

        buscadorPortal.addEventListener("keydown", function (evento) {
            if (evento.key === "Enter") {
                buscarEnPortal();
            }
        });
    });
</script>