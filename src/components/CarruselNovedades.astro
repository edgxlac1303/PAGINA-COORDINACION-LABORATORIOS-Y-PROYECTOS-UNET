<section class="novedades-carrusel"> <!-- CARRUSEL INFORMATIVO -->
    <h2>Novedades de la Coordinación</h2>

    <div class="carrusel">

        <button class="btn-carrusel btn-anterior">◀</button>

        <article class="slide activo">
            <img src="/assets/img/novedad1.jpeg" alt="Novedad de la coordinación">
            
            <div class="contenido-slide">
                <h3>Recorrido Virtual 360° en Desarrollo</h3>
                <p>
                    En colaboración con estudiantes de la asignatura Programación II, se está trabajando en la incorporación de recorridos 360° para
                    facilitar la ubicación de los laboratorios dentro de la universidad.
                </p>
            </div>
        </article>

        <article class="slide">
            <img src="/assets/img/estudiantes-lab.png" alt="Solicitud de mantenimiento">
    
            <div class="contenido-slide">
                <h3>Visita académica a los laboratorios de la UNET</h3>
                <p>
                    Estudiantes próximos a graduarse conocieron laboratorios, proyectos e instalaciones que podrían formar parte de su futura casa de estudios.
                </p>
            </div>
        </article>

        <article class="slide">
            <img src="/assets/img/labsoldadura.png" alt="Información sobre laboratorios">

            <div class="contenido-slide">
                <h3>Recuperación de espacios para la formación práctica</h3>
                <p>
                    El trabajo constante de la Coordinación ha permitido mantener y recuperar espacios de laboratorio, fortaleciendo las condiciones necesarias para el desarrollo de prácticas académicas esenciales.
                </p>
            </div>
        </article>

        <button class="btn-carrusel btn-siguiente">▶</button>

    </div>
</section>

<script>
    // LOGICA DEL CARRUSEL DE NOVEDADES

    const carruseles = document.querySelectorAll(".novedades-carrusel");

    carruseles.forEach(function (carrusel) {
        const botonAnterior = carrusel.querySelector(".btn-anterior");
        const botonSiguiente = carrusel.querySelector(".btn-siguiente");
        const slides = carrusel.querySelectorAll(".slide");

        let indiceActual = 0;

        if (!botonAnterior || !botonSiguiente || slides.length === 0) {
            return;
        }

        botonSiguiente.addEventListener("click", function () {
            slides[indiceActual].classList.remove("activo");

            indiceActual = indiceActual + 1;

            if (indiceActual >= slides.length) {
                indiceActual = 0;
            }

            slides[indiceActual].classList.add("activo");
        });

        botonAnterior.addEventListener("click", function () {
            slides[indiceActual].classList.remove("activo");

            indiceActual = indiceActual - 1;

            if (indiceActual < 0) {
                indiceActual = slides.length - 1;
            }

            slides[indiceActual].classList.add("activo");
        });
    });
</script>

